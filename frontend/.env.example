# Soft access gate for hosted test builds (baked into the client bundle — not real security).
# Production builds load `.env.production` automatically (`npm run build`).
# Leave empty / omit for local `npm run dev` without a password prompt.
# VITE_APP_ACCESS_PASSWORD=Test1234!

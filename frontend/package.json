{
  "name": "bouwtofml",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc -b && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:e2e": "vitest run --config vitest.e2e.config.ts",
    "test:watch": "vitest",
    "knip:fml-embed": "vitest run tests/ui/fml-embed-boundary.spec.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "prepare": "cd .. && husky frontend/.husky",
    "layer-diff": "node --experimental-strip-types scripts/layer-diff.ts",
    "wall-orientation-inventory": "node --experimental-strip-types scripts/wall-orientation-inventory.ts",
    "esc:check": "node --experimental-strip-types scripts/check-esc-tags.ts --check",
    "esc:report": "node --experimental-strip-types scripts/check-esc-tags.ts --report",
    "esc:coverage": "node --experimental-strip-types scripts/check-esc-tags.ts --coverage",
    "esc:missing": "node --experimental-strip-types scripts/check-esc-tags.ts --missing",
    "esc:index": "node --experimental-strip-types scripts/check-esc-tags.ts --write-index",
    "esc:grootboek": "node --experimental-strip-types scripts/esc-grootboek.ts --write-ledger",
    "esc:killswitch": "node --experimental-strip-types scripts/esc-killswitch.ts"
  },
  "lint-staged": {
    "*.{ts,vue}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,yml,yaml}": [
      "prettier --write"
    ]
  },
  "dependencies": {
    "@opencvjs/web": "^4.13.0-release.1",
    "@tesseract.js-data/eng": "^1.0.0",
    "@tesseract.js-data/nld": "^1.0.0",
    "@turf/line-intersect": "^7.3.5",
    "konva": "^9.3.20",
    "pdfjs-dist": "^6.0.227",
    "polygon-clipping": "^0.15.7",
    "rbush": "^4.0.1",
    "skeleton-tracing-wasm": "^1.0.3",
    "tesseract.js": "^7.0.0",
    "vue": "^3.5.13",
    "vue-i18n": "^11.4.8",
    "vue-konva": "^3.2.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.13.10",
    "@types/rbush": "^4.0.0",
    "@vitejs/plugin-vue": "^5.2.1",
    "canvas": "^3.2.3",
    "eslint": "^10.8.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-vue": "^10.10.0",
    "globals": "^17.8.0",
    "husky": "^9.1.7",
    "jsdom": "^29.1.1",
    "lint-staged": "^16.4.0",
    "prettier": "^3.9.6",
    "typescript": "~5.7.3",
    "typescript-eslint": "^8.65.0",
    "vite": "^6.2.1",
    "vitest": "^3.0.8",
    "vue-tsc": "^2.2.8"
  }
}

{
  "$schema": "https://unpkg.com/knip@5/schema.json",
  "entry": ["src/main.ts"],
  "project": ["src/**/*.{ts,vue}", "tests/**/*.ts"],
  "ignore": [
    "src/archive/**",
    "tests/archive/**",
    "src/**/*.d.ts",
    "vite.config.d.ts",
    "src/ui/views/FmlViewerView.vue"
  ],
  "ignoreDependencies": ["@opencvjs/web", "@tesseract.js-data/eng", "@tesseract.js-data/nld"],
  "ignoreExportsUsedInFile": {
    "interface": true,
    "type": true
  },
  "tags": ["-lintignore"]
}
